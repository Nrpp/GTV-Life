<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="horizontal"
    android:padding="64dp">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:padding="16dp">

        <ImageView
            android:id="@+id/qr"
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:contentDescription="Código QR de configuración" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configura GTV Life desde tu móvil"
            android:textColor="@color/text"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/steps"
            style="@style/Body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:lineSpacingExtra="8dp"
            android:text="1. Conecta el móvil a la misma red Wi-Fi que la TV.\n2. Escanea el código QR con la cámara.\n3. Elige tu ubicación y pega las direcciones iCal secretas de tus calendarios.\n4. Pulsa «Guardar» y la TV se actualizará sola." />

        <TextView
            android:id="@+id/url"
            style="@style/BodyDim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textIsSelectable="false" />

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:textColor="@color/accent"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/card_bg"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="28dp"
            android:paddingTop="14dp"
            android:paddingEnd="28dp"
            android:paddingBottom="14dp"
            android:text="Volver al menú"
            android:textColor="@color/text"
            android:textSize="20sp" />
    </LinearLayout>
</LinearLayout>
